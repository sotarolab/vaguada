 "openapi": "3.1.0",
 "paths": {
  "/api/journal": {
   "post": {
    "description": "The one write route: a person's reading of a day (decision 0006).",
    "operationId": "add_journal_api_journal_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/JournalNew"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JournalEntry"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Add Journal"
   }
  },
  "/api/journal/{station_id}": {
   "get": {
    "operationId": "journal_api_journal__station_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "station_id",
      "required": true,
      "schema": {
       "title": "Station Id",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 60,
       "maximum": 500,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/JournalEntry"
         },
         "title": "Response Journal Api Journal  Station Id  Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Journal"
   }
  },
  "/api/station/{station_id}": {
   "get": {
    "operationId": "station_api_station__station_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "station_id",
      "required": true,
      "schema": {
       "title": "Station Id",
       "type": "string"
      }
     },
     {
      "description": "Point in time; default now",
      "in": "query",
      "name": "as_of",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Point in time; default now",
       "title": "As Of"
      }
     },
     {
      "in": "query",
      "name": "hours_back",
      "required": false,
      "schema": {
       "default": 48,
       "maximum": 240,
       "minimum": 1,
       "title": "Hours Back",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "hours_ahead",
      "required": false,
      "schema": {
       "default": 120,
       "maximum": 192,
       "minimum": 1,
       "title": "Hours Ahead",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StationPage"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Station"
   }
  },
  "/api/stations": {
   "get": {
    "operationId": "stations_api_stations_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Station"
         },
         "title": "Response Stations Api Stations Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Stations"
   }
  },
  "/healthz": {
